<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsAudioManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsAudioManager"
    Title="Windows Audio Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="AppTitleBar" Padding="14,6,14,0" Height="36"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Image Source="ms-appx:///Assets/Icons/display.ico"
                       Width="16" Height="16"/>
                <TextBlock Text="Windows Audio Manager"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    x:Name="NavSidebar">
                <StackPanel Spacing="4" Margin="8,4,8,16">
                    <Button x:Name="MainTabButton"
                            Click="MainTabButton_Click"
                            CornerRadius="4"
                            Width="136" Height="40"
                            Padding="0"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                        </Button.Resources>
                        <Grid>
                            <Border x:Name="MainTabSelectedFill"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7F5;" FontSize="16"/>
                                <TextBlock Text="오디오"/>
                            </StackPanel>
                            <Border x:Name="MainTabIndicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsTabButton"
                            Click="SettingsTabButton_Click"
                            CornerRadius="4"
                            Width="136" Height="40"
                            Padding="0"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
                        </Button.Resources>
                        <Grid>
                            <Border x:Name="SettingsTabSelectedFill"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                <TextBlock Text="설정"/>
                            </StackPanel>
                            <Border x:Name="SettingsTabIndicator"
                                    Width="3" Height="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0"/>

            <Grid Grid.Column="1" x:Name="ContentArea" Margin="24,20,24,20">
                <StackPanel x:Name="MainTabContent" Spacing="16">

                    <TextBlock Text="오디오"
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontFamily="{StaticResource AppFontBold}"/>

                    <!-- Equalizer APO -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Equalizer APO"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Grid MinHeight="68" Padding="16,0" ColumnSpacing="16"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9E9;" FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="LoudMax"/>
                                <TextBlock Text="Equalizer APO가 설치되어 있어야 동작합니다"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="LoudMaxToggle"
                                          OnContent="켬" OffContent="끔"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="LoudMaxToggle_Toggled"/>
                        </Grid>
                    </StackPanel>

                    <!-- 장치 -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="장치"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Bottom"/>
                            <Button Click="RefreshButton_Click" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="새로고침"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Padding="8" Spacing="4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                <TextBlock Text="출력"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="OutputCountText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="OutputList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal"
                                                               MaximumRowsOrColumns="2"
                                                               ItemWidth="284" ItemHeight="42"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AudioDevice">
                                        <Button Click="DeviceButton_Click"
                                                Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind Name}"
                                                Style="{StaticResource DeviceItemButtonStyle}">
                                            <Grid>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind CheckVisibility}"/>
                                                <Border Width="3" Height="16"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="1.5"
                                                        Visibility="{x:Bind CheckVisibility}"/>
                                                <Grid ColumnSpacing="10" Padding="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE7F5;" FontSize="16"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <FontIcon Glyph="&#xE7F5;" FontSize="16"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Visibility="{x:Bind CheckVisibility}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Margin="8,6"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,4">
                                <TextBlock Text="입력"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="InputCountText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="InputList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal"
                                                               MaximumRowsOrColumns="2"
                                                               ItemWidth="284" ItemHeight="42"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AudioDevice">
                                        <Button Click="DeviceButton_Click"
                                                Tag="{x:Bind Id}"
                                                ToolTipService.ToolTip="{x:Bind Name}"
                                                Style="{StaticResource DeviceItemButtonStyle}">
                                            <Grid>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{x:Bind CheckVisibility}"/>
                                                <Border Width="3" Height="16"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="1.5"
                                                        Visibility="{x:Bind CheckVisibility}"/>
                                                <Grid ColumnSpacing="10" Padding="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE720;" FontSize="16"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <FontIcon Glyph="&#xE720;" FontSize="16"
                                                              VerticalAlignment="Center"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Visibility="{x:Bind CheckVisibility}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SettingsTabContent" Spacing="16" Opacity="0" IsHitTestVisible="False">
                    <TextBlock Text="설정"
                               Style="{StaticResource TitleTextBlockStyle}"
                               FontFamily="{StaticResource AppFontBold}"/>

                    <StackPanel Spacing="4">
                        <Grid MinHeight="64" Padding="16,0" ColumnSpacing="16"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8,8,4,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;" FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Windows 시작 시 자동 실행"/>
                                <TextBlock Text="창을 띄우지 않고 트레이 아이콘으로 시작합니다"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" x:Name="AutoStartToggle"
                                          OnContent="켬" OffContent="끔"
                                          MinWidth="0"
                                          VerticalAlignment="Center"
                                          Toggled="AutoStartToggle_Toggled"/>
                        </Grid>

                        <Grid MinHeight="64" Padding="16,0" ColumnSpacing="16"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="4,4,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="프로그램 종료"/>
                                <TextBlock Text="트레이 아이콘까지 완전히 종료합니다"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="종료"
                                    VerticalAlignment="Center"
                                    Click="ExitButton_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="2"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0"
              Padding="16,6"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE946;" FontSize="12"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Grid.Column="1" x:Name="LogText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="1"
              Grid.RowSpan="2"
              Background="#66000000"
              Visibility="Collapsed">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>
    </Grid>
</Window>
